    {
      "id": "docs_agents_tasks_049_gemini_guide_stop_default_action_fix",
      "label": "Stop prevents reused Submit default action",
      "file_type": "concept",
      "source_file": "D:/Projects/Hamsterhub/Map Project Showcase/Docs/agents/tasks/049-gemini-guide.md",
      "source_location": "L86-L92",
      "summary": "A real browser regression exposed a Stop button being reused as Submit during the click. preventDefault before Stop prevents unintended resubmission; the held-response test passes. Review-only checks select the explicit compiled review outDir through PLAYWRIGHT_REVIEW_BUILD=1.",
      "_origin": "semantic"
    },
