{
  "nodes": [
    {
      "id": "docs_agents_tasks_049_gemini_guide_doc",
      "label": "Task 049: conversational Gemini Guide",
      "file_type": "document",
      "source_file": "D:/Projects/Hamsterhub/Map Project Showcase/Docs/agents/tasks/049-gemini-guide.md",
      "source_location": "L1-L106",
      "summary": "The user defers polish and chooses fictional-only text chat through a Gemini server function and equivalent local support. Server catalogs, bounded requests, validated clickable results and graceful failure are implemented locally; live provider and deployment verification remain pending.",
      "_origin": "semantic",
      "status": "Implemented locally; no live provider request or deployment"
    },
    {
      "id": "docs_agents_tasks_049_gemini_guide_fictional_server_catalog",
      "label": "Server-owned fictional catalog",
      "file_type": "rationale",
      "source_file": "D:/Projects/Hamsterhub/Map Project Showcase/Docs/agents/tasks/049-gemini-guide.md",
      "source_location": "L11-L17",
      "summary": "POST /api/guide accepts default/group/review dataset, question, bounded recent turns and optional fictional context IDs. The server builds its own fictional text catalog; no client catalog, owner input, images/PDFs, media fetches, remote tools or arbitrary URL actions enter it.",
      "_origin": "semantic",
      "rationale": "The user authorizes fictional samples only; user-submitted questions do not authorize private-file access or owner-record transmission."
    },
    {
      "id": "docs_agents_tasks_049_gemini_guide_request_contract",
      "label": "Bounded chat request contract",
      "file_type": "concept",
      "source_file": "D:/Projects/Hamsterhub/Map Project Showcase/Docs/agents/tasks/049-gemini-guide.md",
      "source_location": "L11-L17",
      "summary": "Dataset/question/history/context are validated before provider work. Current implementation bounds questions to1000 characters, history to6 user/assistant messages of2000 characters each and context to180 characters; streamed request body is capped at48KiB.",
      "_origin": "semantic",
      "implementation_detail": "Bounds are mapped from inspected current contract and server source; task packet establishes the bounded-request requirement."
    },
    {
      "id": "docs_agents_tasks_049_gemini_guide_server_gemini_transport",
      "label": "Server Gemini Interactions transport",
      "file_type": "concept",
      "source_file": "D:/Projects/Hamsterhub/Map Project Showcase/Docs/agents/tasks/049-gemini-guide.md",
      "source_location": "L19-L22",
      "summary": "Native server fetch uses the documented Gemini Interactions API with structured JSON text, store:false, bounded output and a deadline. Model/key remain server-only configuration; no new SDK is required.",
      "_origin": "semantic",
      "provider_execution_status": "Unverified live; controlled-fetch checks only; no provider request performed"
    },
    {
      "id": "docs_agents_tasks_049_gemini_guide_reply_target_validation",
      "label": "Server and visible-client target validation",
      "file_type": "concept",
      "source_file": "D:/Projects/Hamsterhub/Map Project Showcase/Docs/agents/tasks/049-gemini-guide.md",
      "source_location": "L23-L26",
      "summary": "Server validates returned target IDs against its own catalog and supplies labels. The frontend intersects IDs with currently visible and explicitly linked fictional records, derives canonical local labels, renders model text as plain text and offers only click-triggered navigation.",
      "_origin": "semantic"
    },
    {
      "id": "docs_agents_tasks_049_gemini_guide_click_navigation",
      "label": "Click-only existing journey navigation",
      "file_type": "concept",
      "source_file": "D:/Projects/Hamsterhub/Map Project Showcase/Docs/agents/tasks/049-gemini-guide.md",
      "source_location": "L23-L31",
      "summary": "A result button click opens the existing directory/province/student/competition journey. Chat never auto-navigates; manual browsing and graphics fallback remain available when chat fails.",
      "_origin": "semantic"
    },
    {
      "id": "docs_agents_tasks_049_gemini_guide_bounded_chat_state",
      "label": "Bounded in-memory chat and cancellation",
      "file_type": "concept",
      "source_file": "D:/Projects/Hamsterhub/Map Project Showcase/Docs/agents/tasks/049-gemini-guide.md",
      "source_location": "L28-L31",
      "summary": "Chat supports sending, Stop, error/retry and Clear, bounded component-state history, abort on minimize/unmount and keyboard/phone use. Scripted help and opt-in narration remain separate; failure does not block browsing.",
      "_origin": "semantic"
    },
    {
      "id": "docs_agents_tasks_049_gemini_guide_request_usage_controls",
      "label": "Per-instance request and usage controls",
      "file_type": "rationale",
      "source_file": "D:/Projects/Hamsterhub/Map Project Showcase/Docs/agents/tasks/049-gemini-guide.md",
      "source_location": "L33-L36",
      "summary": "Same-origin validation, bounded bodies/output, no-store responses, deadlines, per-instance rate/concurrency limits and no automatic retries limit incidental usage. No prompt/response/key logs or retained chat storage. These controls do not provide durable global spending limits.",
      "_origin": "semantic",
      "rationale": "Provider quotas and billing controls are still required before public deployment; per-process limits do not establish a global currency cap."
    },
    {
      "id": "docs_agents_tasks_049_gemini_guide_function_and_local_adapters",
      "label": "Vercel entry and Vite dev/preview adapters",
      "file_type": "concept",
      "source_file": "D:/Projects/Hamsterhub/Map Project Showcase/Docs/agents/tasks/049-gemini-guide.md",
      "source_location": "L67-L70",
      "summary": "api/guide.ts exposes the server handler. Vite dev/preview middleware adapts local Node requests. The explicit review build bundles an ESM function at.review-build/api/guide.js without importing private owner input.",
      "_origin": "semantic"
    },
    {
      "id": "docs_agents_tasks_049_gemini_guide_verification",
      "label": "Task 049 controlled verification",
      "file_type": "concept",
      "source_file": "D:/Projects/Hamsterhub/Map Project Showcase/Docs/agents/tasks/049-gemini-guide.md",
      "source_location": "L76-L98",
      "summary": "135 units, application/browser typechecks and normal/review builds pass.15 distinct compiled Edge checks pass:14 normal-build chat/character cases plus1 review build using a synthetic owner stand-in. Responsive chat, bounded history, plain text, canonical click navigation, Stop/minimize, retry/Clear, nested focus, narration and actual context restoration are covered. Local method/input and missing-key compiled-function checks pass.",
      "_origin": "semantic",
